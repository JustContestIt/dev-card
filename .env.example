# --- Application ---
NODE_ENV=development
PORT=3000
# Public origin of the deployed card (used for links in vCard / logs)
PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins ("*" for demo purposes)
CORS_ORIGINS=*

# --- Database (CockroachDB) ---
# Local single-node CockroachDB from docker-compose:
DATABASE_URL=postgresql://root@localhost:26257/dev_card?sslmode=disable
# CockroachDB Cloud (production) example:
# DATABASE_URL=postgresql://user:password@host:26257/dev_card?sslmode=verify-full

# --- Security / rate limiting ---
# Salt for hashing visitor IPs (privacy: raw IPs are never stored)
IP_HASH_SALT=change-me-to-a-random-string
# Max contact messages per hour from a single IP
CONTACT_RATE_LIMIT=3

# --- Logging ---
LOG_LEVEL=info
